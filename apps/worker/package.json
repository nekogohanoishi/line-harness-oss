{
  "name": "worker",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "test": "pnpm --filter @line-crm/shared build && vitest run",
    "build": "pnpm --filter @line-crm/shared build && vite build && pnpm run sync:admin",
    "build:with-admin": "pnpm --filter web build && pnpm run build",
    "sync:admin": "node scripts/sync-admin-assets.mjs",
    "preview": "vite preview",
    "deploy": "pnpm run build:with-admin && wrangler deploy",
    "typecheck": "pnpm --filter @line-crm/shared build && tsc --noEmit"
  },
  "dependencies": {
    "@line-crm/db": "workspace:*",
    "@line-crm/line-sdk": "workspace:*",
    "@line-crm/shared": "workspace:*",
    "hono": "^4.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.20241205.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0",
    "wrangler": "^4.0.0"
  }
}
